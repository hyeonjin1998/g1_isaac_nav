Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
      Splitter Ratio: 0.5
    Tree Height: 700
  - Class: rviz_common/Views
    Name: Views
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset: {X: 0, Y: 0, Z: 0}
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true

    # ---------- 맵 / 코스트맵 ----------
    # 지그재그 원인 진단의 핵심: 계획이 이상한 건지, 코스트맵이 이상한 건지 구분합니다.
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: 1. RTAB-Map 격자 (정적)
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Alpha: 0.6
      Color Scheme: map
      Draw Behind: true
      Update Topic: {Value: /map_updates}
      Use Timestamp: false
      Value: true

    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: 2. Global costmap (계획 근거)
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_costmap/costmap
      Alpha: 0.4
      Color Scheme: costmap
      Draw Behind: false
      Update Topic: {Value: /global_costmap/costmap_updates}
      Use Timestamp: false
      Value: true

    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: 3. Local costmap (회피 근거)
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/costmap
      Alpha: 0.7
      Color Scheme: costmap
      Draw Behind: false
      Update Topic: {Value: /local_costmap/costmap_updates}
      Use Timestamp: false
      Value: true

    # ---------- 목표 / 경로 / 궤적 ----------
    - Class: rviz_default_plugins/Pose
      Enabled: true
      Name: 4. 목표 위치 (노랑)
      Color: 255; 220; 0
      Alpha: 1
      Head Length: 0.3
      Head Radius: 0.15
      Shaft Length: 0.8
      Shaft Radius: 0.06
      Shape: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
      Value: true

    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 255; 0
      Enabled: true
      Head Diameter: 0
      Line Style: Billboards
      Line Width: 0.06
      Name: 5. 전역 계획 /plan (초록)
      Offset: {X: 0, Y: 0, Z: 0.02}
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /plan
      Value: true

    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 170; 255
      Enabled: true
      Head Diameter: 0
      Line Style: Billboards
      Line Width: 0.05
      Name: 6. 국소 계획 /local_plan (파랑)
      Offset: {X: 0, Y: 0, Z: 0.04}
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_plan
      Value: true

    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 40; 40
      Enabled: true
      Head Diameter: 0
      Line Style: Billboards
      Line Width: 0.07
      Name: 7. 실제 주행 궤적 (빨강)
      Offset: {X: 0, Y: 0, Z: 0.06}
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /traveled_path
      Value: true

    # ---------- 로봇 상태 ----------
    - Class: rviz_default_plugins/Polygon
      Enabled: true
      Name: 8. 로봇 footprint
      Color: 255; 255; 255
      Alpha: 1
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/published_footprint
      Value: true

    - Angle Tolerance: 0.1
      Class: rviz_default_plugins/Odometry
      Covariance: {Value: false}
      Enabled: false
      Keep: 200
      Name: 9. Odometry (기본 꺼짐)
      Position Tolerance: 0.2
      Shape:
        Alpha: 1
        Axes Length: 0.25
        Axes Radius: 0.02
        Color: 255; 85; 0
        Value: Axes
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odom
      Value: false

    - Class: rviz_default_plugins/TF
      Enabled: false
      Frame Timeout: 15
      Frames: {All Enabled: true}
      Marker Scale: 0.5
      Name: 10. TF (기본 꺼짐)
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: false

    # ---------- 센서 ----------
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds: {Max Value: 3, Min Value: -1, Value: true}
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: 11. MID-360
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.02
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /mid360/points
      Use Fixed Frame: true
      Use rainbow: true
      Value: true

    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds: {Max Value: 3, Min Value: -1, Value: true}
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 150; 0
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: false
      Name: 12. D435i 깊이 클라우드 (기본 꺼짐)
      Position Transformer: XYZ
      Size (Pixels): 2
      Size (m): 0.02
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/depth/points
      Use Fixed Frame: true
      Use rainbow: false
      Value: false

    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: 13. D435i 컬러
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /camera/color/image_raw
      Value: true

  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic: {Value: /initialpose}
    - Class: rviz_default_plugins/SetGoal
      Topic: {Value: /goal_pose}
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 22
      Focal Point: {X: 0, Y: 0, Z: 0}
      Name: Current View
      Pitch: 1.2
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 3.9
    Saved: ~
Window Geometry:
  Displays: {collapsed: false}
  Height: 950
  Width: 1700
  Hide Left Dock: false
  Hide Right Dock: true
