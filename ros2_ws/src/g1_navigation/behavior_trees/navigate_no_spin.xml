<!--
  G1 보행 정책용 Behavior Tree — 제자리 회전/후진 복구 없음.

  Nav2 기본 BT(navigate_to_pose_w_replanning_and_recovery.xml)는 복구 행동으로
  Spin 과 BackUp 을 호출합니다. 그런데 Phase 1 실측 결과 이 보행 정책은

    - 제자리 회전(wz 단독): 1.0 rad/s 에서야 겨우 돌고 38% 오차
    - 후진(vx < 0):         −0.4 에서 29% 오차

  라서 두 복구 모두 제대로 수행되지 않습니다. 실행하면 로봇이 제자리에서
  버둥대다 복구 실패로 내비게이션이 중단되거나, 최악의 경우 넘어집니다.

  그래서 복구는 **코스트맵 클리어 → 탈출용 후진 → 대기 → 재계획** 으로 구성합니다.
  Spin 은 제외하지만 BackUp 은 포함합니다 — 둘 다 막으면 벽에 코를 박은 로봇이
  영영 빠져나오지 못합니다. 후진 정확도(22~29% 오차)는 탈출 목적에는 충분합니다.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">

      <PipelineSequence name="NavigateWithReplanning">
        <!-- 1 Hz 로 전역 경로 재계획 -->
        <RateController hz="1.0">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Context"
                                service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>

        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <ClearEntireCostmap name="ClearLocalCostmap-Context"
                              service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>

      <!-- 복구: 코스트맵 클리어 → 탈출 후진 → 대기 → 재계획.
           Spin(제자리 회전)만 제외합니다. -->
      <SequenceStar name="RecoveryActions">
        <ClearEntireCostmap name="ClearGlobalCostmap-Subtree"
                            service_name="global_costmap/clear_entirely_global_costmap"/>
        <ClearEntireCostmap name="ClearLocalCostmap-Subtree"
                            service_name="local_costmap/clear_entirely_local_costmap"/>
        <!-- 벽에 코를 박고 갇히면 코스트맵을 비워도 경로가 생기지 않습니다.
             제자리 회전과 후진을 둘 다 막아두면 영영 못 빠져나오므로,
             **탈출용 후진만** 허용합니다.
             backup_speed 0.5 는 보행 개시 임계값(0.4) 위여야 실제로 움직입니다
             — Nav2 기본값 0.025 로는 정책이 명령을 무시합니다.
             0.5 보다 크게 잡아도 소용없습니다: 정책 학습 범위가 vx∈[-0.5,1.0] 이라
             set_command 에서 -0.5 로 클램프됩니다.
             거리는 0.8→0.5 로 줄였습니다. 실측 후진 속도가 명령의 78%(-0.389)라
             12초 안에 0.8m 를 못 채우고 "Exceeded time allowance" 로 실패했습니다.
             탈출에는 0.5m 면 충분합니다. -->
        <BackUp backup_dist="0.5" backup_speed="0.5" time_allowance="20"/>
        <Wait wait_duration="2.0"/>
      </SequenceStar>

    </RecoveryNode>
  </BehaviorTree>
</root>
